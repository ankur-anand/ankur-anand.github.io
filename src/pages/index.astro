---
import PostCard from "../components/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import projectsText from "../data/projects.txt?raw";
import { getPublishedPosts } from "../lib/posts";
import { parseProjects } from "../lib/projects";
import { SITE } from "../lib/site";
import avatar from "../../images/site/avatar.jpg";

const posts = await getPublishedPosts();
const latestPosts = posts.slice(0, 4);
const projects = parseProjects(projectsText);
const profileSchema = [
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    mainEntity: {
      "@type": "Person",
      name: SITE.author,
      url: SITE.url,
      jobTitle: "Staff Software Engineer",
      sameAs: Object.values(SITE.social),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    url: SITE.url,
  },
];
---

<BaseLayout
  schema={profileSchema}
  image="/social/home.png"
  imageAlt="Ankur Anand, software engineer and writer."
  imageWidth={1200}
  imageHeight={630}
>
  <section class="home-intro">
    <div>
      <h1>Ankur Anand</h1>
      <p class="home-intro__role">
        <span>Staff Software Engineer at Walmart Global Tech</span>, based in Bengaluru.
      </p>
      <p class="home-intro__lead">
        I work on distributed systems and platform infrastructure, mostly in Go.
        I write about databases, runtimes, performance, and the parts of software
        that are easy to use but difficult to understand.
      </p>
      <p>
        Writing helps me slow down and test what I understand. Away from software,
        I make photographs and sometimes write poetry.
      </p>
      <p class="home-intro__links">
        <a href="/about/">More about me</a>
        <a href={SITE.social.github}>GitHub</a>
        <a href={SITE.social.linkedin}>LinkedIn</a>
      </p>
    </div>
    <img
      class="home-intro__photo"
      src={avatar.src}
      width={avatar.width}
      height={avatar.height}
      alt="Ankur Anand"
    />
  </section>

  <section class="home-section" id="projects" aria-labelledby="projects-heading">
    <div class="home-section__heading">
      <h2 id="projects-heading">Projects</h2>
      <p>Things I build and maintain outside work.</p>
    </div>
    <ul class="project-list">
      {
        projects.map((project) => (
          <li>
            <h3><a href={project.repository}>{project.name}</a></h3>
            <p>{project.description}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="home-section" aria-labelledby="latest-writing">
    <div class="home-section__heading">
      <h2 id="latest-writing">Recent writing</h2>
      {posts.length > 0 && <a href="/blog/">All {posts.length} articles</a>}
    </div>

    {
      latestPosts.length > 0 ? (
        <div class="archive-list">
          {latestPosts.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <p class="archive-note">
          The archive is also available on <a href="https://blog.ankuranand.com">the old blog</a> and
          <a href={SITE.social.medium}> Medium</a>.
        </p>
      )
    }
  </section>

  <section class="home-section home-elsewhere" aria-labelledby="elsewhere-heading">
    <h2 id="elsewhere-heading">Elsewhere</h2>
    <p>
      I keep source code on <a href={SITE.social.github}>GitHub</a>, photographs on
      <a href="https://500px.com/amateurgrapher"> 500px</a>, and poetry at
      <a href="https://tangledvibes.com"> Tangled Vibes</a>.
    </p>
  </section>
</BaseLayout>
